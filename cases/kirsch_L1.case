# Kirsch plate with a hole, refinement level 1 (SPEC section 8).
# Paths are relative to the working directory (run from the repository root).
mesh             = meshes/kirsch_L1.msh
plane            = plane_stress
E                = 210e9
nu               = 0.3
thickness        = 0.01
partitioner      = metis
solver           = cg_jacobi
rtol             = 1e-10
max_iter         = 20000
output_dir       = results/kirsch_L1
# boundary conditions
bc.dirichlet     = left_sym:ux=0 ; bottom_sym:uy=0
bc.traction      = kirsch_exact
kirsch.sigma_inf = 100e6
kirsch.a         = 0.1
