# Checks the run metadata in <DIR>/timings.json (cmake -P, no Python needed).
#   -DDIR=<output dir> -DEXPECT_PATH=serial|distributed -DEXPECT_RANKS=<n>
#   [-DEXPECT_PETSC=<pc type>]  solver = petsc: PETSc phases and the PC type actually used
if(NOT DEFINED DIR OR NOT DEFINED EXPECT_PATH OR NOT DEFINED EXPECT_RANKS)
  message(FATAL_ERROR "usage: cmake -DDIR=.. -DEXPECT_PATH=.. -DEXPECT_RANKS=.. -P check_timings.cmake")
endif()
file(READ "${DIR}/timings.json" json)
string(JSON path GET "${json}" path)
string(JSON ranks GET "${json}" ranks)
string(JSON converged GET "${json}" solver converged)
message(STATUS "${DIR}: path ${path}, ranks ${ranks}, converged ${converged}")
if(NOT path STREQUAL EXPECT_PATH OR NOT ranks EQUAL EXPECT_RANKS OR NOT converged)
  message(FATAL_ERROR "expected path ${EXPECT_PATH} on ${EXPECT_RANKS} rank(s), converged")
endif()
if(path STREQUAL "distributed")
  # Every phase has min/max/mean over ranks.
  foreach(phase read partition distribute assembly bcs solve postprocess output total)
    foreach(stat min max mean)
      string(JSON v GET "${json}" timings ${phase} ${stat})
    endforeach()
  endforeach()
  string(JSON n LENGTH "${json}" load owned_rows)
  if(NOT n EQUAL EXPECT_RANKS)
    message(FATAL_ERROR "load report has ${n} ranks, expected ${EXPECT_RANKS}")
  endif()
endif()
if(DEFINED EXPECT_PETSC)
  string(JSON name GET "${json}" solver name)
  string(JSON pc GET "${json}" solver pc_type)
  if(NOT name STREQUAL "petsc" OR NOT pc STREQUAL EXPECT_PETSC)
    message(FATAL_ERROR "expected solver petsc with PC ${EXPECT_PETSC}, got ${name} / ${pc}")
  endif()
  foreach(phase petsc_matrix pc_setup ksp_solve)
    foreach(stat min max mean)
      string(JSON v GET "${json}" timings ${phase} ${stat})
    endforeach()
  endforeach()
endif()
message(STATUS "timings check passed")
